---
import Base from '@/layouts/Base.astro'
import { PostCard } from '@/components/blog/PostCard.tsx'
import { getCollection, type CollectionEntry } from 'astro:content'

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft)
  const tagSet = new Set(posts.flatMap((p) => p.data.tags))
  return [...tagSet].map((tag) => ({
    params: { tag },
    props: {
      posts: posts.filter((p) => p.data.tags.includes(tag)),
      tag,
    },
  }))
}

interface Props {
  posts: CollectionEntry<'blog'>[]
  tag: string
}

const { posts, tag } = Astro.props
---
<Base
  title={`#${tag} — razzkumar`}
  description={`Posts tagged #${tag}`}
>
  <section class="mx-auto max-w-2xl px-4 py-20" style="color: #F2EBDD;">
    <p class="font-mono text-[12px] uppercase tracking-[0.3em] mb-3" style="color: #D94B1F;">tagged</p>
    <h1 class="text-5xl md:text-6xl font-semibold tracking-tight mb-10">#{tag}</h1>
    {posts.length === 0 ? (
      <p class="font-mono text-[#8A8073]">No posts under this tag.</p>
    ) : (
      <ul class="space-y-5 list-none p-0">
        {posts.map((p) => <li><PostCard post={p} /></li>)}
      </ul>
    )}
    <a href="/blog/" class="inline-block mt-12 font-mono text-[12px]" style="color: #D94B1F;">← back to /blog</a>
  </section>
</Base>
